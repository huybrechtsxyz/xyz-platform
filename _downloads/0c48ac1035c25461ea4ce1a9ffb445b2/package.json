        },
        {
          "command": "strata.validateCurrentFile",
          "when": "resourceExtname == .yaml && strata.workspaceActive",
          "group": "strata@3"
        },
        {
          "command": "strata.auditChanges",
          "when": "resourceExtname == .yaml && strata.workspaceActive",
