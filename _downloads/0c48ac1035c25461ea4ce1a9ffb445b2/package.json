        },
        {
          "command": "strata.showDependencyGraph",
          "when": "resourceExtname == .yaml && strata.workspaceActive",
          "group": "strata@10"
        },
        {
          "command": "strata.showTopologyDiagram",
          "when": "resourceExtname == .yaml && strata.workspaceActive",
          "group": "strata@11"
        },
        {
          "command": "strata.previewDiagramFile",
          "when": "resourceExtname == .yaml && strata.workspaceActive",
          "group": "strata@12"
        }
      ]
