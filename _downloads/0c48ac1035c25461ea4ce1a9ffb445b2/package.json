        },
        {
          "command": "strata.checkPolicy",
          "when": "resourceExtname == .yaml && strata.workspaceActive",
          "group": "strata@8"
        },
        {
          "command": "strata.lockStatus",
          "when": "resourceExtname == .yaml && strata.workspaceActive",
